--- !u!114 &6477496540731354290
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4418130297335726298}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#7A5A40>\uC2DC\uD589\uC77C: 2026\uB144 6\uC6D4 24\uC77C</color>\n\n\uBCF8
    \uAC1C\uC778\uC815\uBCF4\uCC98\uB9AC\uBC29\uCE68\uC740 RedEyes(\uC774\uD558 \"\uC11C\uBE44\uC2A4
    \uC81C\uACF5\uC790\")\uAC00 \uC6B4\uC601\uD558\uB294 \uBAA8\uBC14\uC77C \uC571
    <b>Train Defense</b> \uBC0F \uAD00\uB828 \uC11C\uBE44\uC2A4(\uC774\uD558 \"\uBCF8
    \uC560\uD50C\uB9AC\uCF00\uC774\uC158\")\uC5D0 \uC801\uC6A9\uB429\uB2C8\uB2E4.\n\n<size=120%><b>\uC815\uBCF4\uC758
    \uC218\uC9D1 \uBC0F \uC774\uC6A9</b></size>\n\uBCF8 \uC560\uD50C\uB9AC\uCF00\uC774\uC158\uC740
    \uB2E4\uC6B4\uB85C\uB4DC \uBC0F \uC0AC\uC6A9 \uC2DC \uB2E4\uC74C\uACFC \uAC19\uC740
    \uC815\uBCF4\uB97C \uC218\uC9D1\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4:\n  \u2022
    \uAE30\uAE30\uC758 IP \uC8FC\uC18C\n  \u2022 \uBC29\uBB38\uD55C \uD654\uBA74,
    \uBC29\uBB38 \uC77C\uC2DC, \uAC01 \uD654\uBA74\uC5D0 \uBA38\uBB38 \uC2DC\uAC04\n 
    \u2022 \uC571 \uC774\uC6A9 \uC2DC\uAC04\n  \u2022 \uC0AC\uC6A9 \uC911\uC778 \uBAA8\uBC14\uC77C
    \uC6B4\uC601\uCCB4\uC81C\n\uB610\uD55C \uAC8C\uC784 \uBD84\uC11D\uC744 \uC704\uD574
    \uAC8C\uC784\uD50C\uB808\uC774 \uD589\uB3D9 \uB370\uC774\uD130(\uC608: \uAC8C\uC784
    \uC2DC\uC791\xB7\uC885\uB8CC, \uB3C4\uB2EC\uD55C \uC2A4\uD14C\uC774\uC9C0, \uC778\uAC8C\uC784
    \uC120\uD0DD, \uC810\uC218, \uD50C\uB808\uC774 \uC2DC\uAC04 \uB4F1)\uB97C \uC218\uC9D1\uD569\uB2C8\uB2E4.
    \uC774 \uB370\uC774\uD130\uB294 \uAC8C\uC784 \uB0B4 \uD589\uB3D9\uC5D0 \uD55C\uC815\uB418\uBA70,
    \uC774\uB984\xB7\uC774\uBA54\uC77C\xB7\uC804\uD654\uBC88\uD638\xB7\uC815\uBC00
    \uC704\uCE58 \uB4F1 \uC9C1\uC811\uC801\uC778 \uAC1C\uC778\uC2DD\uBCC4\uC815\uBCF4\uB294
    \uC218\uC9D1\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n<b>\uAD11\uACE0 \uBBF8\uC0AC\uC6A9:</b>
    \uBCF8 \uC560\uD50C\uB9AC\uCF00\uC774\uC158\uC740 \uAD11\uACE0\uB97C \uAC8C\uC7AC\uD558\uC9C0
    \uC54A\uC73C\uBA70, \uAD11\uACE0 \uC2DD\uBCC4\uC790\uB97C \uAD11\uACE0 \uB610\uB294
    \uB9C8\uCF00\uD305 \uBAA9\uC801\uC73C\uB85C \uC0AC\uC6A9\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\n<size=120%><b>\uB3D9\uC758
    \uBC0F \uB3D9\uC758 \uCCA0\uD68C</b></size>\n\uBD84\uC11D \uB370\uC774\uD130
    \uC218\uC9D1\uC740 \uCD5C\uCD08 \uC2E4\uD589 \uC2DC \uD45C\uC2DC\uB418\uB294
    \uB3D9\uC758 \uD654\uBA74\uC5D0\uC11C \uC774\uC6A9\uC790\uAC00 \uBA85\uC2DC\uC801\uC73C\uB85C
    \uB3D9\uC758(\uC635\uD2B8\uC778)\uD55C \uACBD\uC6B0\uC5D0\uB9CC \uC774\uB8E8\uC5B4\uC9D1\uB2C8\uB2E4.
    \uB3D9\uC758\uD558\uAE30 \uC804\uC5D0\uB294 \uC218\uC9D1\uC774 \uC815\uC9C0\uB429\uB2C8\uB2E4.
    \uB3D9\uC758 \uD6C4\uC5D0\uB3C4 \uC571 \uB0B4 <b>\uC124\uC815(\uC635\uC158) \uD654\uBA74\uC758
    \uB370\uC774\uD130 \uC218\uC9D1 \uB3D9\uC758 \uD1A0\uAE00</b>\uC744 \uD1B5\uD574
    \uC5B8\uC81C\uB4E0\uC9C0 \uB3D9\uC758\uB97C \uCCA0\uD68C\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n<size=120%><b>\uCFE0\uD0A4
    \uBC0F \uCD94\uC801 \uAE30\uC220</b></size>\n\uBCF8 \uC560\uD50C\uB9AC\uCF00\uC774\uC158
    \uB610\uB294 \uC81C3\uC790 SDK\uB294 \uAE30\uB2A5 \uC81C\uACF5, \uBD84\uC11D,
    \uC11C\uBE44\uC2A4 \uC6B4\uC601\uC744 \uC704\uD574 \uCFE0\uD0A4, SDK, \uD53D\uC140
    \uBC0F \uC720\uC0AC \uAE30\uC220\uC744 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uAD00\uB828 \uBC95\uB839\uC774 \uC694\uAD6C\uD558\uB294 \uACBD\uC6B0, \uC11C\uBE44\uC2A4
    \uC81C\uACF5\uC790\uB294 \uD544\uC218\uC801\uC774\uC9C0 \uC54A\uC740 \uCD94\uC801
    \uAE30\uC220\uC744 \uC0AC\uC6A9\uD558\uAE30 \uC804\uC5D0 \uB3D9\uC758\uB97C \uBC1B\uC2B5\uB2C8\uB2E4.\n\n<size=120%><b>\uC774\uC6A9\uC790\uC758
    \uAD8C\uB9AC</b></size>\n\uC774\uC6A9\uC790\uB294 \uC11C\uBE44\uC2A4 \uC81C\uACF5\uC790\uAC00
    \uBCF4\uC720\uD55C \uBCF8\uC778\uC758 \uAC1C\uC778\uC815\uBCF4\uC5D0 \uB300\uD574
    \uC5F4\uB78C, \uC815\uC815 \uB610\uB294 \uC0AD\uC81C\uB97C \uC694\uCCAD\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC774\uB7EC\uD55C \uAD8C\uB9AC \uD589\uC0AC
    \uB610\uB294 \uB3D9\uC758\uC5D0 \uAE30\uBC18\uD55C \uCC98\uB9AC\uC758 \uB3D9\uC758
    \uCCA0\uD68C\uB97C \uC704\uD574\uC11C\uB294 redeyeshq@gmail.com \uC73C\uB85C
    \uC5F0\uB77D\uD574 \uC8FC\uC2ED\uC2DC\uC624.\n\n<size=120%><b>\uCE98\uB9AC\uD3EC\uB2C8\uC544
    \uC8FC\uBBFC\uC758 \uAD8C\uB9AC (CCPA/CPRA)</b></size>\n\uCE98\uB9AC\uD3EC\uB2C8\uC544
    \uC8FC\uBBFC\uC778 \uACBD\uC6B0, \uC218\uC9D1\uB418\uB294 \uAC1C\uC778\uC815\uBCF4\uB97C
    \uC54C \uAD8C\uB9AC, \uAC1C\uC778\uC815\uBCF4 \uC0AD\uC81C\uB97C \uC694\uCCAD\uD560
    \uAD8C\uB9AC, \uAC1C\uC778\uC815\uBCF4\uC758 \uD310\uB9E4\xB7\uACF5\uC720\uB97C
    \uAC70\uBD80(\uC635\uD2B8\uC544\uC6C3)\uD560 \uAD8C\uB9AC, \uADF8\uB9AC\uACE0
    \uC774\uB7EC\uD55C \uAD8C\uB9AC \uD589\uC0AC\uB85C \uC778\uD55C \uCC28\uBCC4\uC744
    \uBC1B\uC9C0 \uC54A\uC744 \uAD8C\uB9AC\uAC00 \uC788\uC2B5\uB2C8\uB2E4. CCPA/CPRA
    \uAD8C\uB9AC \uD589\uC0AC\uB97C \uC704\uD574\uC11C\uB294 redeyeshq@gmail.com
    \uC73C\uB85C \uC5F0\uB77D\uD574 \uC8FC\uC2ED\uC2DC\uC624.\n\uB354 \uB098\uC740
    \uC0AC\uC6A9 \uACBD\uD5D8\uC744 \uC704\uD574, \uC11C\uBE44\uC2A4 \uC81C\uACF5\uC790\uB294
    \uAE30\uAE30 \uC2DD\uBCC4\uC790\uB97C \uD3EC\uD568\uD55C \uC77C\uBD80 \uAC1C\uC778\uC2DD\uBCC4\uC815\uBCF4\uC758
    \uC81C\uACF5\uC744 \uC694\uCCAD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC694\uCCAD\uB41C
    \uC815\uBCF4\uB294 \uBCF8 \uAC1C\uC778\uC815\uBCF4\uCC98\uB9AC\uBC29\uCE68\uC5D0
    \uAE30\uC220\uB41C \uB300\uB85C \uBCF4\uAD00 \uBC0F \uC774\uC6A9\uB429\uB2C8\uB2E4.\n\n<size=120%><b>\uC81C3\uC790
    \uC811\uADFC</b></size>\n\uC11C\uBE44\uC2A4 \uBC0F \uC560\uD50C\uB9AC\uCF00\uC774\uC158
    \uAC1C\uC120\uC744 \uB3D5\uAE30 \uC704\uD574, \uC9D1\uACC4\uB418\uACE0 \uC775\uBA85\uD654\uB41C
    \uB370\uC774\uD130\uB9CC \uC678\uBD80 \uC11C\uBE44\uC2A4\uB85C \uC8FC\uAE30\uC801\uC73C\uB85C
    \uC804\uC1A1\uB429\uB2C8\uB2E4. \uC11C\uBE44\uC2A4 \uC81C\uACF5\uC790\uB294 \uBCF8
    \uBC29\uCE68\uC5D0 \uAE30\uC220\uB41C \uBC29\uC2DD\uC73C\uB85C \uC81C3\uC790\uC640
    \uC815\uBCF4\uB97C \uACF5\uC720\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uBCF8
    \uC560\uD50C\uB9AC\uCF00\uC774\uC158\uC740 \uC790\uCCB4 \uAC1C\uC778\uC815\uBCF4\uCC98\uB9AC\uBC29\uCE68\uC744
    \uAC00\uC9C4 \uC81C3\uC790 \uC11C\uBE44\uC2A4\uB97C \uC774\uC6A9\uD569\uB2C8\uB2E4.
    \uC774\uC6A9 \uC911\uC778 \uC81C3\uC790 \uC11C\uBE44\uC2A4\uC758 \uAC1C\uC778\uC815\uBCF4\uCC98\uB9AC\uBC29\uCE68
    \uB9C1\uD06C\uB294 \uB2E4\uC74C\uACFC \uAC19\uC2B5\uB2C8\uB2E4:\n  \u2022 <link=\"https://firebase.google.com/support/privacy\"><color=#2F6FB0><u>Google
    Analytics for Firebase</u></color></link>\n  \u2022 <link=\"https://unity3d.com/legal/privacy-policy\"><color=#2F6FB0><u>Unity</u></color></link>\n\uC11C\uBE44\uC2A4
    \uC81C\uACF5\uC790\uB294 \uB2E4\uC74C\uC758 \uACBD\uC6B0 \uC774\uC6A9\uC790 \uC81C\uACF5
    \uC815\uBCF4 \uBC0F \uC790\uB3D9 \uC218\uC9D1 \uC815\uBCF4\uB97C \uACF5\uAC1C\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4:\n  \u2022 \uC18C\uD658\uC7A5 \uB610\uB294 \uC720\uC0AC\uD55C
    \uBC95\uC801 \uC808\uCC28 \uC900\uC218 \uB4F1 \uBC95\uB960\uC774 \uC694\uAD6C\uD558\uB294
    \uACBD\uC6B0\n  \u2022 \uAD8C\uB9AC \uBCF4\uD638, \uC774\uC6A9\uC790 \uB610\uB294
    \uD0C0\uC778\uC758 \uC548\uC804 \uBCF4\uD638, \uC0AC\uAE30 \uC870\uC0AC, \uC815\uBD80
    \uC694\uCCAD \uB300\uC751\uC744 \uC704\uD574 \uACF5\uAC1C\uAC00 \uD544\uC694\uD558\uB2E4\uACE0
    \uC120\uC758\uB85C \uD310\uB2E8\uD558\uB294 \uACBD\uC6B0\n  \u2022 \uC11C\uBE44\uC2A4
    \uC81C\uACF5\uC790\uB97C \uB300\uC2E0\uD574 \uC5C5\uBB34\uB97C \uC218\uD589\uD558\uACE0,
    \uACF5\uAC1C\uB41C \uC815\uBCF4\uB97C \uB3C5\uB9BD\uC801\uC73C\uB85C \uC0AC\uC6A9\uD558\uC9C0
    \uC54A\uC73C\uBA70, \uBCF8 \uBC29\uCE68\uC758 \uADDC\uCE59\uC744 \uC900\uC218\uD558\uAE30\uB85C
    \uB3D9\uC758\uD55C \uC2E0\uB8B0\uD560 \uC218 \uC788\uB294 \uC11C\uBE44\uC2A4
    \uC81C\uACF5\uC5C5\uCCB4\uC640 \uACF5\uC720\uD558\uB294 \uACBD\uC6B0\n\n<size=120%><b>\uAD6D\uC81C
    \uB370\uC774\uD130 \uC774\uC804</b></size>\n\uC11C\uBE44\uC2A4 \uC81C\uACF5\uC790
    \uB610\uB294 \uC81C3\uC790 \uC11C\uBE44\uC2A4 \uC81C\uACF5\uC5C5\uCCB4\uB294
    \uC774\uC6A9\uC790\uC758 \uAC70\uC8FC \uAD6D\uAC00 \uC678(\uC720\uB7FD\uACBD\uC81C\uC9C0\uC5ED(EEA)
    \uC678 \uD3EC\uD568)\uB85C \uAC1C\uC778\uC815\uBCF4\uB97C \uC774\uC804\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uAD00\uB828 \uBC95\uB839\uC774 \uAD6D\uC81C
    \uC774\uC804\uC5D0 \uB300\uD55C \uBCF4\uD638\uC870\uCE58\uB97C \uC694\uAD6C\uD558\uB294
    \uACBD\uC6B0, \uC11C\uBE44\uC2A4 \uC81C\uACF5\uC790\uB294 \uB2E4\uC74C\uACFC
    \uAC19\uC740 \uC801\uC808\uD55C \uC7A5\uCE58\uB97C \uC0AC\uC6A9\uD569\uB2C8\uB2E4:\n 
    \u2022 \uC720\uB7FD\uC5F0\uD569 \uC9D1\uD589\uC704\uC6D0\uD68C\uAC00 \uC2B9\uC778\uD55C
    \uD45C\uC900\uACC4\uC57D\uC870\uD56D(SCC)\n  \u2022 \uC801\uC815\uC131 \uACB0\uC815
    \uB610\uB294 \uAE30\uD0C0 \uBC95\uC801\uC73C\uB85C \uC778\uC815\uB418\uB294 \uC774\uC804
    \uBA54\uCEE4\uB2C8\uC998\n  \u2022 \uBC95\uC801\uC73C\uB85C \uC694\uAD6C\uB418\uACE0
    \uD5C8\uC6A9\uB418\uB294 \uACBD\uC6B0, \uC774\uC6A9\uC790\uC758 \uB3D9\uC758\n\uD0C0
    \uAD6D\uAC00\uC758 \uAC1C\uC778\uC815\uBCF4\uBCF4\uD638 \uBC95\uB960\uC740 \uC774\uC6A9\uC790\uC758
    \uAD00\uD560\uAD8C\uACFC \uB2E4\uB97C \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uBC95\uB960\uC774
    \uC694\uAD6C\uD558\uB294 \uACBD\uC6B0, \uC11C\uBE44\uC2A4 \uC81C\uACF5\uC790\uB294
    \uC801\uC808\uD55C \uBCF4\uD638\uC870\uCE58\uB97C \uC801\uC6A9\uD558\uACE0 \uC774\uC804\uC5D0
    \uD544\uC694\uD55C \uB3D9\uC758\uB97C \uBC1B\uC2B5\uB2C8\uB2E4.\n\n<size=120%><b>\uC635\uD2B8\uC544\uC6C3
    \uAD8C\uB9AC</b></size>\n\uBCF8 \uC560\uD50C\uB9AC\uCF00\uC774\uC158\uC744 \uC0AD\uC81C(\uC81C\uAC70)\uD558\uC5EC
    \uAE30\uAE30\uB85C\uBD80\uD130\uC758 \uCD94\uAC00 \uC815\uBCF4 \uC218\uC9D1\uC744
    \uC911\uB2E8\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC571\uC744 \uC0AD\uC81C\uD558\uBA74
    \uAE30\uAE30\uC5D0\uC11C\uC758 \uB370\uC774\uD130 \uC218\uC9D1\uC740 \uC911\uB2E8\uB418\uC9C0\uB9CC,
    \uC774\uBBF8 \uC11C\uBE44\uC2A4 \uC81C\uACF5\uC790 \uB610\uB294 \uC81C3\uC790\uC5D0\uAC8C
    \uC804\uC1A1\uB41C \uC815\uBCF4\uAC00 \uC790\uB3D9\uC73C\uB85C \uC0AD\uC81C\uB418\uC9C0\uB294
    \uC54A\uC2B5\uB2C8\uB2E4.\n\uAC1C\uC778\uC815\uBCF4 \uC0AD\uC81C \uC694\uCCAD,
    \uB3D9\uC758 \uCCA0\uD68C \uB610\uB294 \uAD8C\uB9AC \uD589\uC0AC\uB97C \uC704\uD574\uC11C\uB294
    redeyeshq@gmail.com \uC73C\uB85C \uC5F0\uB77D\uD574 \uC8FC\uC2ED\uC2DC\uC624.\n\n<size=120%><b>\uB370\uC774\uD130
    \uBCF4\uAD00 \uC815\uCC45</b></size>\n\uC11C\uBE44\uC2A4 \uC81C\uACF5\uC790\uB294
    \uBA85\uC2DC\uB41C \uBAA9\uC801\uC5D0 \uD544\uC694\uD55C \uAE30\uAC04 \uB3D9\uC548
    \uAC1C\uC778\uC815\uBCF4\uB97C \uBCF4\uAD00\uD569\uB2C8\uB2E4:\n  \u2022 \uC774\uC6A9\uC790
    \uC81C\uACF5 \uB370\uC774\uD130: \uC560\uD50C\uB9AC\uCF00\uC774\uC158 \uC774\uC6A9
    \uAE30\uAC04 \uBC0F \uADF8 \uC774\uD6C4 12\uAC1C\uC6D4\uAC04 \uBCF4\uAD00(\uBC95\uB960\uC774
    \uB354 \uAE34 \uBCF4\uAD00\uC744 \uC694\uAD6C\uD558\uB294 \uACBD\uC6B0 \uC81C\uC678)\n 
    \u2022 \uC790\uB3D9 \uC218\uC9D1 \uB370\uC774\uD130: \uC218\uC9D1 \uC2DC\uC810\uC73C\uB85C\uBD80\uD130
    \uCD5C\uB300 24\uAC1C\uC6D4\uAC04 \uBCF4\uAD00(\uBC95\uC801 \uC900\uC218\uB97C
    \uC704\uD574 \uB354 \uAE34 \uBCF4\uAD00\uC774 \uD544\uC694\uD55C \uACBD\uC6B0
    \uC81C\uC678)\n  \u2022 \uC9D1\uACC4\xB7\uC775\uBA85\uD654 \uB370\uC774\uD130:
    \uB354 \uC774\uC0C1 \uAC1C\uC778\uC744 \uC2DD\uBCC4\uD558\uC9C0 \uC54A\uC73C\uBBC0\uB85C
    \uBB34\uAE30\uD55C \uBCF4\uAD00\n  \u2022 \uBC95\uC801 \uC900\uC218\uB97C \uC704\uD55C
    \uB370\uC774\uD130: \uAD00\uB828 \uBC95\uB839\uC774 \uC694\uAD6C\uD558\uB294
    \uAE30\uAC04 \uB3D9\uC548 \uBCF4\uAD00\n\uBC95\uC801 \uBCF4\uAD00 \uC758\uBB34\uB97C
    \uB530\uB974\uB294 \uBC94\uC704 \uB0B4\uC5D0\uC11C \uAC1C\uC778\uC815\uBCF4 \uC0AD\uC81C\uB97C
    \uC694\uCCAD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC560\uD50C\uB9AC\uCF00\uC774\uC158\uC744
    \uD1B5\uD574 \uC81C\uCD9C\uD55C \uC774\uC6A9\uC790 \uC81C\uACF5 \uB370\uC774\uD130\uC758
    \uC0AD\uC81C\uB97C \uC6D0\uD558\uC2DC\uBA74 redeyeshq@gmail.com \uC73C\uB85C
    \uC5F0\uB77D\uD574 \uC8FC\uC2ED\uC2DC\uC624. \uC77C\uBD80 \uC774\uC6A9\uC790
    \uC81C\uACF5 \uB370\uC774\uD130\uB294 \uC560\uD50C\uB9AC\uCF00\uC774\uC158\uC758
    \uC815\uC0C1 \uC791\uB3D9\uC5D0 \uD544\uC694\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n<size=120%><b>\uC544\uB3D9</b></size>\n\uBCF8
    \uC560\uD50C\uB9AC\uCF00\uC774\uC158\uC740 \uB9CC 16\uC138 \uBBF8\uB9CC(\uB610\uB294
    \uAD00\uB828 \uBC95\uB839\uC774 \uC694\uAD6C\uD558\uB294 \uADF8 \uC774\uC0C1\uC758
    \uC5F0\uB839) \uC544\uB3D9\uC744 \uB300\uC0C1\uC73C\uB85C \uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
    \uC11C\uBE44\uC2A4 \uC81C\uACF5\uC790\uB294 \uC544\uB3D9\uC73C\uB85C\uBD80\uD130
    \uACE0\uC758\uB85C \uB370\uC774\uD130\uB97C \uC218\uC9D1\uD558\uAC70\uB098 \uC544\uB3D9\uC5D0\uAC8C
    \uC560\uD50C\uB9AC\uCF00\uC774\uC158\uC744 \uB9C8\uCF00\uD305\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\uAD00\uB828
    \uBC95\uB839\uC5D0 \uB530\uB77C \uBD80\uBAA8 \uB610\uB294 \uBCF4\uD638\uC790\uC758
    \uB3D9\uC758\uAC00 \uD544\uC694\uD55C \uACBD\uC6B0, \uBCF8 \uC560\uD50C\uB9AC\uCF00\uC774\uC158\uC740
    \uADF8 \uB3D9\uC758 \uC5C6\uC774 \uC0AC\uC6A9\uD558\uB3C4\uB85D \uC758\uB3C4\uB418\uC9C0
    \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uC11C\uBE44\uC2A4 \uC81C\uACF5\uC790\uB294 \uAD00\uB828
    \uBC95\uB839\uC744 \uC704\uBC18\uD558\uC5EC \uB9CC 16\uC138 \uBBF8\uB9CC \uC544\uB3D9\uC758
    \uAC1C\uC778\uC2DD\uBCC4\uC815\uBCF4\uB97C \uACE0\uC758\uB85C \uC218\uC9D1\uD558\uC9C0
    \uC54A\uC2B5\uB2C8\uB2E4. \uC544\uB3D9\uC774 \uAC1C\uC778\uC815\uBCF4\uB97C \uC81C\uACF5\uD55C
    \uC0AC\uC2E4\uC744 \uBC1C\uACAC\uD558\uB294 \uACBD\uC6B0, \uC11C\uBE44\uC2A4
    \uC81C\uACF5\uC790\uB294 \uD574\uB2F9 \uC815\uBCF4\uB97C \uC989\uC2DC \uC11C\uBC84\uC5D0\uC11C
    \uC0AD\uC81C\uD569\uB2C8\uB2E4. \uC790\uB140\uAC00 \uAC1C\uC778\uC815\uBCF4\uB97C
    \uC81C\uACF5\uD55C \uC0AC\uC2E4\uC744 \uC54C\uAC8C \uB41C \uBD80\uBAA8 \uB610\uB294
    \uBCF4\uD638\uC790\uAED8\uC11C\uB294 redeyeshq@gmail.com \uC73C\uB85C \uC5F0\uB77D\uD574
    \uC8FC\uC2DC\uBA74 \uD544\uC694\uD55C \uC870\uCE58\uB97C \uCDE8\uD558\uACA0\uC2B5\uB2C8\uB2E4.\n\n<size=120%><b>\uBCF4\uC548</b></size>\n\uC11C\uBE44\uC2A4
    \uC81C\uACF5\uC790\uB294 \uC774\uC6A9\uC790 \uC815\uBCF4\uC758 \uAE30\uBC00\uC131
    \uBCF4\uD638\uC5D0 \uC8FC\uC758\uB97C \uAE30\uC6B8\uC785\uB2C8\uB2E4. \uC11C\uBE44\uC2A4
    \uC81C\uACF5\uC790\uB294 \uCC98\uB9AC\xB7\uC720\uC9C0\uD558\uB294 \uC815\uBCF4\uB97C
    \uBCF4\uD638\uD558\uAE30 \uC704\uD574 \uBB3C\uB9AC\uC801, \uC804\uC790\uC801,
    \uC808\uCC28\uC801 \uBCF4\uD638\uC870\uCE58\uB97C \uC81C\uACF5\uD569\uB2C8\uB2E4.\n\n<size=120%><b>\uB370\uC774\uD130
    \uC720\uCD9C \uD1B5\uC9C0</b></size>\n\uC774\uC6A9\uC790\uC758 \uAC1C\uC778\uC815\uBCF4\uC5D0
    \uC601\uD5A5\uC744 \uBBF8\uCE58\uB294 \uB370\uC774\uD130 \uC720\uCD9C\uC774 \uBC1C\uC0DD\uD558\uB294
    \uACBD\uC6B0, \uC11C\uBE44\uC2A4 \uC81C\uACF5\uC790\uB294 \uAD00\uB828 \uBC95\uC801
    \uC694\uAD6C\uC0AC\uD56D\uC5D0 \uB530\uB77C \uC774\uC6A9\uC790\uC5D0\uAC8C \uD1B5\uC9C0\uD558\uBA70,
    \uD544\uC694\uD55C \uACBD\uC6B0 \uC720\uCD9C\uC758 \uC131\uACA9 \uBC0F \uB300\uC751
    \uC870\uCE58\uC5D0 \uAD00\uD55C \uC815\uBCF4\uB97C \uC81C\uACF5\uD569\uB2C8\uB2E4.\n\n<size=120%><b>\uBCC0\uACBD</b></size>\n\uC11C\uBE44\uC2A4
    \uC81C\uACF5\uC790\uB294 \uBCF8 \uAC1C\uC778\uC815\uBCF4\uCC98\uB9AC\uBC29\uCE68\uC744
    \uC218\uC2DC\uB85C \uC5C5\uB370\uC774\uD2B8\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uC911\uC694\uD55C \uBCC0\uACBD \uC0AC\uD56D\uC774 \uC788\uB294 \uACBD\uC6B0
    \uC2DC\uD589\uC77C\uACFC \uD568\uAED8 \uC5C5\uB370\uC774\uD2B8\uB41C \uBC29\uCE68\uC744
    \uAC8C\uC2DC\uD558\uC5EC \uD1B5\uC9C0\uD569\uB2C8\uB2E4. \uBC95\uB960\uC774 \uC694\uAD6C\uD558\uB294
    \uACBD\uC6B0, \uC911\uC694\uD55C \uBCC0\uACBD\uC774 \uC801\uC6A9\uB418\uAE30
    \uC804\uC5D0 \uC774\uC6A9\uC790\uC758 \uB3D9\uC758\uB97C \uAD6C\uD569\uB2C8\uB2E4.\n\uC774\uC804
    \uBC84\uC804\uC758 \uAC1C\uC778\uC815\uBCF4\uCC98\uB9AC\uBC29\uCE68\uC740 \uBCF4\uAD00\uB418\uBA70,
    redeyeshq@gmail.com \uC73C\uB85C \uC694\uCCAD\uD558\uC2DC\uBA74 \uC81C\uACF5\uD574
    \uB4DC\uB9BD\uB2C8\uB2E4.\n\n<size=120%><b>\uB3D9\uC758</b></size>\n\uCC98\uB9AC\uAC00
    \uB3D9\uC758\uC5D0 \uAE30\uBC18\uD558\uB294 \uACBD\uC6B0, \uC774\uC6A9\uC790\uB294
    \uD574\uB2F9 \uAE30\uB2A5 \uB610\uB294 \uB3D9\uC791\uC5D0 \uC801\uADF9\uC801\uC73C\uB85C
    \uB3D9\uC758(\uC635\uD2B8\uC778)\uD568\uC73C\uB85C\uC368 \uB3D9\uC758\uB97C \uC81C\uACF5\uD569\uB2C8\uB2E4.
    \uC774\uC6A9\uC790\uB294 \uCCA0\uD68C \uC774\uC804\uC5D0 \uC218\uD589\uB41C \uCC98\uB9AC\uC5D0
    \uC601\uD5A5\uC744 \uC8FC\uC9C0 \uC54A\uACE0 \uC5B8\uC81C\uB4E0\uC9C0 \uB3D9\uC758\uB97C
    \uCCA0\uD68C\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uAE30\uD0C0 \uC801\uBC95\uD55C
    \uADFC\uAC70\uC5D0 \uAE30\uBC18\uD55C \uCC98\uB9AC\uB294 \uC704\uC5D0 \uAE30\uC220\uB41C
    \uB300\uB85C \uC218\uD589\uB429\uB2C8\uB2E4.\n\n<size=120%><b>\uBB38\uC758\uCC98</b></size>\n\uBCF8
    \uC560\uD50C\uB9AC\uCF00\uC774\uC158 \uC774\uC6A9 \uC911 \uAC1C\uC778\uC815\uBCF4\uC640
    \uAD00\uB828\uD558\uC5EC \uC9C8\uBB38\uC774 \uC788\uAC70\uB098 \uCC98\uB9AC \uAD00\uD589\uC5D0
    \uB300\uD574 \uBB38\uC758\uD558\uC2E4 \uC0AC\uD56D\uC774 \uC788\uC73C\uC2DC\uBA74
    redeyeshq@gmail.com \uC73C\uB85C \uC774\uBA54\uC77C\uC744 \uBCF4\uB0B4 \uC8FC\uC2ED\uC2DC\uC624.\n\n<color=#7A5A40>\xA9
    2026 RedEyes \u2014 Train Defense</color>\n"
